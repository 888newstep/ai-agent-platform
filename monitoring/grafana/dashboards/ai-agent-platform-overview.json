{
  "title": "AI Agent Platform Overview",
  "uid": "ai-agent-platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chat Throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_chat_requests_total[5m])) by (mode, status)",
          "legendFormat": "{{mode}} / {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chat P95 Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_chat_latency_seconds_bucket[5m])) by (le, mode, status))",
          "legendFormat": "{{mode}} / {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RAG Search QPS",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_rag_search_total[5m])) by (cache)",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAG P95 Latency",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_rag_search_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Document Ingestion Count",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_document_ingestion_total[24h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
