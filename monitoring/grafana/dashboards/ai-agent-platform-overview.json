{
  "title": "AI Agent Platform Overview",
  "uid": "ai-agent-platform-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chat Throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_chat_requests_total[5m])) by (mode, status)",
          "legendFormat": "{{mode}} / {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chat P95 Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_chat_latency_seconds_bucket[5m])) by (le, mode, status))",
          "legendFormat": "{{mode}} / {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RAG Search QPS",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_rag_search_total[5m])) by (cache)",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "RAG P95 Latency",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_rag_search_latency_seconds_bucket[5m])) by (le, cache))",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Document Ingestion Count",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_document_ingestion_total[24h])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Adaptive RAG Routes and End Reasons",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_rag_adaptive_total[5m])) by (route, end_reason)",
          "legendFormat": "{{route}} / {{end_reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Adaptive RAG Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_rag_adaptive_total{status=\"error\"}[5m])) / clamp_min(sum(rate(ai_rag_adaptive_total[5m])), 0.001)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ReAct Stop Reasons",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_agent_react_total[5m])) by (stop_reason)",
          "legendFormat": "{{stop_reason}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Multi-Agent Fallbacks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_agent_multi_total{single_agent_fallback=\"true\"}[5m]))",
          "legendFormat": "single-agent fallback"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_agent_multi_total{synthesis_fallback=\"true\"}[5m]))",
          "legendFormat": "synthesis fallback"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Semantic Cache Hit Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_cache_semantic_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(ai_cache_semantic_total[5m])), 0.001)",
          "legendFormat": "semantic cache hit rate"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Multi-Agent Worker Failures per Request",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_agent_multi_worker_failures_sum[5m])) / clamp_min(sum(rate(ai_agent_multi_total[5m])), 0.001)",
          "legendFormat": "worker failures / request"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tool Calls by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_agent_tool_total[5m])) by (tool, status, outcome)",
          "legendFormat": "{{tool}} / {{status}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Tool P95 Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_agent_tool_latency_seconds_bucket[5m])) by (le, tool, status))",
          "legendFormat": "{{tool}} / {{status}}"
        }
      ]
    }
  ]
}