# AI Agent Platform - Environment Variables Example
# Copy this file to .env and fill in the values you actually use.

# ============================================
# Default model provider (application.yml uses DeepSeek by default)
# ============================================
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional alternative model providers
QIANWEN_API_KEY=your-qianwen-api-key-here
DOUBAO_API_KEY=your-doubao-api-key-here
QWEN3_FLASH_API_KEY=your-qwen3-flash-api-key-here

# Embedding provider (application.yml uses SiliconFlow by default)
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# ============================================
# Public API protection
# Fixed-window Redis quotas; fail-open keeps local development available if Redis is down.
# ============================================
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS_PER_MINUTE=30
AI_RATE_LIMIT_FAIL_OPEN=true
AI_COST_BUDGET_ENABLED=true
AI_ESTIMATED_TOKENS_PER_MINUTE=12000
AI_MAX_ESTIMATED_TOKENS_PER_REQUEST=4000
AI_MAX_INPUT_CHARACTERS=12000
AI_TOKENS_PER_CHARACTER=1.0
AI_PROMPT_OVERHEAD_TOKENS=256
AI_COST_BUDGET_FAIL_OPEN=true
# ============================================
# Security
# ============================================
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_API_KEY=replace-with-a-random-admin-key

# ============================================
# Tool outbound allowlist
# Wildcards like *.example.com are supported.
# Private / loopback hosts are rejected by ToolService.
# ============================================
AI_TOOL_ALLOWED_HOSTS=api.example.com,*.example.com

# ============================================
# MySQL
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
# Optional override; normally you do not need to change this.
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0

# ============================================
# Milvus
# ============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_CONNECTION_TIMEOUT_MS=2000

# ============================================
# Observability (used by docker-compose monitoring stack)
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# ============================================
# Optional data import feature
# ============================================
AI_EVALUATION_DATASET_DIRECTORY=./evaluation-datasets
AI_EVALUATION_REPORT_DIRECTORY=./evaluation-reports

CS_IMPORT_DATA_DIR=
