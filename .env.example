# AI Agent Platform - Environment Variables Example
# Copy this file to .env and fill in your actual values

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Qianwen (通义千问) API Configuration
QIANWEN_API_KEY=your-qianwen-api-key-here

# Wenxin (文心一言) API Configuration
WENXIN_API_KEY=your-wenxin-api-key-here
WENXIN_SECRET_KEY=your-wenxin-secret-key-here

# Doubao (豆包-火山引擎) API Configuration
DOUBAO_API_KEY=your-doubao-api-key-here

# Qwen3 Flash (阿里云百炼) API Configuration
QWEN3_FLASH_API_KEY=your-qwen3-flash-api-key-here

# SiliconFlow Embedding API Configuration
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# JWT Secret Key (generate a secure random key for production)
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long

# Admin API Key for protected endpoints
ADMIN_API_KEY=change-this-admin-api-key

# Grafana Configuration (optional, used by docker-compose monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123456

# Allowed outbound API hosts for tool calls (comma-separated)
AI_TOOL_ALLOWED_HOSTS=api.example.com

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_agent
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_CONNECTION_TIMEOUT_MS=2000

# Training Data Import Directory (optional, for data import feature)
CS_IMPORT_DATA_DIR=

# PGVector Configuration (optional)
PGVECTOR_PASSWORD=postgres
